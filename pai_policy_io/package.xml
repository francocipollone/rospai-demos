<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pai_policy_io</name>
  <version>0.1.0</version>
  <description>
    Policy I/O pipeline: policy signature model, pipeline hash and the
    nodes that turn robot topics into named tensors for policy inference.
  </description>
  <maintainer email="franco.cipollone@ekumenlabs.com">Franco Cipollone</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>pai_tensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosetta</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
